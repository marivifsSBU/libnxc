diff --git a/XClib/xc_nxc.f90 b/XClib/xc_nxc.f90
new file mode 100644
index 0000000..e1cfd24
--- /dev/null
+++ b/XClib/xc_nxc.f90
@@ -0,0 +1,278 @@
+!
+! Copyright (C) 2026 Quantum ESPRESSO group
+! This file is distributed under the terms of the
+! GNU General Public License. See the file `License'
+! in the root directory of the present distribution,
+! or http://www.gnu.org/copyleft/gpl.txt .
+!
+!----------------------------------------------------------------------------
+MODULE xc_nxc
+  !--------------------------------------------------------------------------
+  !! Machine-learned LDA / GGA / meta-GGA functionals through libnxc.
+  !
+  !! Selected with input_dft='NXC'.  The model directory (containing the
+  !! TorchScript file 'xc') is read from the environment variable NXC_MODEL;
+  !! its name must start with LDA_, GGA_ or MGGA_, which sets the family.
+  !! The whole functional is evaluated by libnxc:
+  !!  - LDA:  in xc()          (energy per particle, as the LDA wrappers)
+  !!  - GGA:  in xc_gcx()      (energy per volume; xc() returns zero: NOX NOC)
+  !!  - MGGA: in xc_metagcx()  (energy per volume; tau in Hartree/Libxc units)
+  !! Units are Hartree, as in the other XClib wrappers.  PBE (GGA) and TPSS
+  !! (meta-GGA) indices are set only as placeholders so that PW computes
+  !! gradients / kinetic energy densities; second derivatives (DFPT) are not
+  !! available and stop with an error.
+  !
+  USE kind_l,  ONLY: DP
+  !
+  IMPLICIT NONE
+  !
+  PRIVATE
+  PUBLIC :: nxc_select, nxc_xc_lda, nxc_xc_gcx, nxc_xc_metagcx
+  !
+  INTEGER, SAVE :: nspin_loaded = 0
+  !
+CONTAINS
+  !
+  !--------------------------------------------------------------------------
+  SUBROUTINE nxc_select( iexch, icorr, igcx, igcc, imeta, imetac )
+    !------------------------------------------------------------------------
+    !! Reads NXC_MODEL, sets the family and the placeholder XC indices.
+    !
+    USE dft_setting_params, ONLY: is_nxc, nxc_model, nxc_family
+    !
+    INTEGER, INTENT(OUT) :: iexch, icorr, igcx, igcc, imeta, imetac
+    !
+    CHARACTER(LEN=512) :: base
+    INTEGER :: stat, i
+    LOGICAL :: found
+    !
+    CALL GET_ENVIRONMENT_VARIABLE( 'NXC_MODEL', nxc_model, STATUS=stat )
+    IF ( stat /= 0 .OR. LEN_TRIM(nxc_model) == 0 ) CALL xclib_error( 'nxc_select', &
+         'input_dft=NXC needs the environment variable NXC_MODEL (model directory)', 1 )
+    !
+    i = LEN_TRIM(nxc_model)
+    IF ( nxc_model(i:i) == '/' ) nxc_model(i:i) = ' '
+    INQUIRE( FILE=TRIM(nxc_model)//'/xc', EXIST=found )
+    IF ( .NOT. found ) CALL xclib_error( 'nxc_select', 'no file xc in NXC_MODEL='// &
+                                         TRIM(nxc_model), 2 )
+    !
+    base = nxc_model( INDEX(nxc_model, '/', BACK=.TRUE.)+1 : )
+    iexch = 0 ; icorr = 0 ; igcx = 0 ; igcc = 0 ; imeta = 0 ; imetac = 0
+    IF ( base(1:4) == 'LDA_' ) THEN
+       nxc_family = 1
+       iexch = 1 ; icorr = 4          ! placeholders (SLA, PW)
+    ELSEIF ( base(1:4) == 'GGA_' ) THEN
+       nxc_family = 2
+       igcx = 3 ; igcc = 4            ! placeholders (PBX, PBC)
+    ELSEIF ( base(1:5) == 'MGGA_' ) THEN
+       nxc_family = 3
+       imeta = 1                      ! placeholder (TPSS)
+    ELSE
+       CALL xclib_error( 'nxc_select', 'model directory name must start with LDA_, &
+                         &GGA_ or MGGA_: '//TRIM(base), 3 )
+    ENDIF
+    is_nxc = .TRUE.
+    nspin_loaded = 0
+    !
+  END SUBROUTINE nxc_select
+  !
+  !
+  !--------------------------------------------------------------------------
+  SUBROUTINE ensure_loaded( ns )
+    !------------------------------------------------------------------------
+    !! Loads the libnxc functional for ns spin channels (1 or 2) if needed.
+    !
+#if defined(__NXC)
+    USE nxc,                ONLY: nxc_init
+#endif
+    USE dft_setting_params, ONLY: nxc_model
+    !
+    INTEGER, INTENT(IN) :: ns
+    INTEGER :: ierr
+    !
+    IF ( ns == nspin_loaded ) RETURN
+#if defined(__NXC)
+    CALL nxc_init( TRIM(nxc_model), ns, ierr )
+    IF ( ierr /= 0 ) CALL xclib_error( 'nxc', 'libnxc could not load '//TRIM(nxc_model), 1 )
+    nspin_loaded = ns
+#else
+    CALL xclib_error( 'nxc', 'QE compiled without libnxc (cmake -DQE_ENABLE_NXC=ON)', 1 )
+#endif
+    !
+  END SUBROUTINE ensure_loaded
+  !
+  !
+  !--------------------------------------------------------------------------
+  SUBROUTINE check( ierr, where )
+    INTEGER, INTENT(IN) :: ierr
+    CHARACTER(LEN=*), INTENT(IN) :: where
+    IF ( ierr /= 0 ) CALL xclib_error( 'nxc', 'libnxc evaluation failed in '//where, ierr )
+  END SUBROUTINE check
+  !
+  !
+  !--------------------------------------------------------------------------
+  SUBROUTINE nxc_xc_lda( length, srd, svd, rho_in, ex_out, ec_out, vx_out, vc_out )
+    !------------------------------------------------------------------------
+    !! LDA: rho_in = (total[, magnetization]); energies per particle.
+    !
+#if defined(__NXC)
+    USE nxc,  ONLY: nxc_lda
+#endif
+    INTEGER,  INTENT(IN)  :: length, srd, svd
+    REAL(DP), INTENT(IN)  :: rho_in(length,srd)
+    REAL(DP), INTENT(OUT) :: ex_out(length), vx_out(length,svd)
+    REAL(DP), INTENT(OUT) :: ec_out(length), vc_out(length,svd)
+    !
+    REAL(DP), ALLOCATABLE :: r(:,:), vr(:,:)
+    REAL(DP) :: amag, arho, zeta
+    INTEGER :: ns, k, ierr
+    !
+    ns = MERGE( 1, 2, srd == 1 )
+    ALLOCATE( r(length,ns), vr(length,ns) )
+    DO k = 1, length
+       IF ( srd == 1 ) THEN
+          r(k,1) = ABS( rho_in(k,1) )
+       ELSE
+          ! as QE's LSDA drivers: zeta = m/|rho| clipped to [-1,1], total |rho| preserved
+          arho = ABS( rho_in(k,1) )
+          amag = MERGE( rho_in(k,2), SQRT(SUM(rho_in(k,2:srd)**2)), srd == 2 )
+          zeta = 0.0_DP
+          IF ( arho > 0.0_DP ) zeta = MAX( -1.0_DP, MIN( 1.0_DP, amag / arho ) )
+          r(k,1) = arho * ( 1.0_DP + zeta ) * 0.5_DP
+          r(k,2) = arho * ( 1.0_DP - zeta ) * 0.5_DP
+       ENDIF
+    ENDDO
+    CALL ensure_loaded( ns )
+#if defined(__NXC)
+    CALL nxc_lda( length, r, ex_out, vr, ierr )
+    CALL check( ierr, 'xc (LDA)' )
+#endif
+    ec_out = 0.0_DP
+    vx_out = 0.0_DP
+    vc_out = 0.0_DP
+    vx_out(:,1:ns) = vr
+    DEALLOCATE( r, vr )
+    !
+  END SUBROUTINE nxc_xc_lda
+  !
+  !
+  !--------------------------------------------------------------------------
+  SUBROUTINE nxc_xc_gcx( length, ns, rho, grho, ex, ec, v1x, v2x, v1c, v2c, v2c_ud )
+    !------------------------------------------------------------------------
+    !! GGA: full functional; ex = rho*eps_xc, v1 = dE/drho, v2 = 2 dE/dsigma_ss,
+    !! v2c_ud = dE/dsigma_ud (conventions of xc_gcx).
+    !
+#if defined(__NXC)
+    USE nxc,  ONLY: nxc_gga
+#endif
+    INTEGER,  INTENT(IN)  :: length, ns
+    REAL(DP), INTENT(IN)  :: rho(length,ns), grho(3,length,ns)
+    REAL(DP), INTENT(OUT) :: ex(length), ec(length)
+    REAL(DP), INTENT(OUT) :: v1x(length,ns), v2x(length,ns), v1c(length,ns), v2c(length,ns)
+    REAL(DP), INTENT(OUT) :: v2c_ud(length)
+    !
+    REAL(DP), ALLOCATABLE :: r(:,:), sig(:,:), exc(:), vr(:,:), vs(:,:)
+    INTEGER :: k, ierr
+    !
+    ALLOCATE( r(length,ns), sig(length,2*ns-1), exc(length), vr(length,ns), vs(length,2*ns-1) )
+    IF ( ns == 1 ) THEN
+       DO k = 1, length
+          r(k,1) = ABS( rho(k,1) )
+          sig(k,1) = SUM( grho(:,k,1)**2 )
+       ENDDO
+    ELSE
+       DO k = 1, length
+          r(k,:) = rho(k,:)
+          sig(k,1) = SUM( grho(:,k,1)**2 )
+          sig(k,2) = SUM( grho(:,k,1)*grho(:,k,2) )
+          sig(k,3) = SUM( grho(:,k,2)**2 )
+       ENDDO
+    ENDIF
+    CALL ensure_loaded( ns )
+#if defined(__NXC)
+    CALL nxc_gga( length, r, sig, exc, vr, vs, ierr )
+    CALL check( ierr, 'xc_gcx (GGA)' )
+#endif
+    ec = 0.0_DP ; v1c = 0.0_DP ; v2c = 0.0_DP ; v2c_ud = 0.0_DP
+    IF ( ns == 1 ) THEN
+       ex(:) = exc(:) * r(:,1) * SIGN( 1.0_DP, rho(:,1) )
+       v1x(:,1) = vr(:,1)
+       v2x(:,1) = 2.0_DP * vs(:,1)
+    ELSE
+       ex(:) = exc(:) * ( rho(:,1) + rho(:,2) )
+       v1x(:,:) = vr(:,:)
+       v2x(:,1) = 2.0_DP * vs(:,1)
+       v2x(:,2) = 2.0_DP * vs(:,3)
+       v2c_ud(:) = vs(:,2)
+    ENDIF
+    DEALLOCATE( r, sig, exc, vr, vs )
+    !
+  END SUBROUTINE nxc_xc_gcx
+  !
+  !
+  !--------------------------------------------------------------------------
+  SUBROUTINE nxc_xc_metagcx( length, ns, np, rho, grho, tau, ex, ec, v1x, v2x, v3x, &
+                             v1c, v2c, v3c )
+    !------------------------------------------------------------------------
+    !! meta-GGA: full functional (conventions of xc_metagcx: ex = rho*eps_xc,
+    !! v2x = 2 dE/dsigma_ss multiplies grad rho_s, v2c holds the cross term
+    !! dE/dsigma_ud * grad rho_s' as a vector, v3 = dE/dtau).
+    !
+#if defined(__NXC)
+    USE nxc,  ONLY: nxc_mgga
+#endif
+    INTEGER,  INTENT(IN)  :: length, ns, np
+    REAL(DP), INTENT(IN)  :: rho(length,ns), grho(3,length,ns), tau(length,ns)
+    REAL(DP), INTENT(OUT) :: ex(length), ec(length)
+    REAL(DP), INTENT(OUT) :: v1x(length,ns), v2x(length,ns), v3x(length,ns)
+    REAL(DP), INTENT(OUT) :: v1c(length,ns), v2c(np,length,ns), v3c(length,ns)
+    !
+    REAL(DP), ALLOCATABLE :: r(:,:), sig(:,:), t(:,:), lap(:,:), exc(:)
+    REAL(DP), ALLOCATABLE :: vr(:,:), vs(:,:), vl(:,:), vt(:,:)
+    INTEGER :: k, ipol, ierr
+    !
+    ALLOCATE( r(length,ns), sig(length,2*ns-1), t(length,ns), lap(length,ns), exc(length) )
+    ALLOCATE( vr(length,ns), vs(length,2*ns-1), vl(length,ns), vt(length,ns) )
+    lap = 0.0_DP
+    IF ( ns == 1 ) THEN
+       DO k = 1, length
+          r(k,1) = ABS( rho(k,1) )
+          sig(k,1) = SUM( grho(:,k,1)**2 )
+          t(k,1) = tau(k,1)
+       ENDDO
+    ELSE
+       DO k = 1, length
+          r(k,:) = rho(k,:)
+          t(k,:) = tau(k,:)
+          sig(k,1) = SUM( grho(:,k,1)**2 )
+          sig(k,2) = SUM( grho(:,k,1)*grho(:,k,2) )
+          sig(k,3) = SUM( grho(:,k,2)**2 )
+       ENDDO
+    ENDIF
+    CALL ensure_loaded( ns )
+#if defined(__NXC)
+    CALL nxc_mgga( length, r, sig, lap, t, exc, vr, vs, vl, vt, ierr )
+    CALL check( ierr, 'xc_metagcx (meta-GGA)' )
+#endif
+    ec = 0.0_DP ; v1c = 0.0_DP ; v2c = 0.0_DP ; v3c = 0.0_DP
+    v1x(:,:) = vr(:,:)
+    v3x(:,:) = vt(:,:)
+    IF ( ns == 1 ) THEN
+       ex(:) = exc(:) * r(:,1)
+       v2x(:,1) = 2.0_DP * vs(:,1)
+    ELSE
+       ex(:) = exc(:) * ( rho(:,1) + rho(:,2) )
+       v2x(:,1) = 2.0_DP * vs(:,1)
+       v2x(:,2) = 2.0_DP * vs(:,3)
+       DO k = 1, length
+          DO ipol = 1, np
+             v2c(ipol,k,1) = vs(k,2) * grho(ipol,k,2)
+             v2c(ipol,k,2) = vs(k,2) * grho(ipol,k,1)
+          ENDDO
+       ENDDO
+    ENDIF
+    DEALLOCATE( r, sig, t, lap, exc, vr, vs, vl, vt )
+    !
+  END SUBROUTINE nxc_xc_metagcx
+  !
+END MODULE xc_nxc
